{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "pc2actividad-ia-api": {
      "root": ".",
      "framework": "fastapi",
      "buildCommand": "pip install -r requirements.txt"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "pc2actividad-ia-api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
